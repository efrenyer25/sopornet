# Copia este archivo como .env y ajusta los valores
FLASK_APP=wsgi.py
FLASK_ENV_CONFIG=development
SECRET_KEY=cambia-esta-clave

# Base de datos (por defecto SQLite en instance/soportenet.db)
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/soportenet
# DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/soportenet

# Inteligencia Artificial (opcional). Sin clave se usa el clasificador local.
ANTHROPIC_API_KEY=
IA_MODELO=claude-haiku-4-5

ZONA_HORARIA=America/Caracas
